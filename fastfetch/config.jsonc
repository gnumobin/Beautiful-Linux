{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": "        ",
  },
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#FFC1E3",
    },
  },
  "modules": [
    "break",

    {
      "type": "os",
      "key": " OS  ",
      "keyColor": "#ff3d6e",
      "format": "{name}",
    },

    {
      "type": "packages",
      "key": " PKG ",
      "keyColor": "#ff9f1c",
    },

    {
      "type": "shell",
      "key": " SH  ",
      "keyColor": "#2ee59d",
      "format": "{pretty-name}",
    },

    {
      "type": "de",
      "key": "󰌢 DE  ",
      "keyColor": "#3a86ff",
      "format": "{pretty-name}",
    },

    {
      "type": "uptime",
      "key": " UP  ",
      "keyColor": "#8338ec",
    },

    {
      "type": "cpu",
      "key": " CPU ",
      "keyColor": "#ff006e",
      "format": "{name}",
    },

    {
      "type": "gpu",
      "key": "󰢮 GPU ",
      "keyColor": "#00bbf9",
      "format": "{name}",
    },

    {
      "type": "memory",
      "key": " RAM ",
      "keyColor": "#f1faee",
      "format": "{used} / {total}",
    },

    {
      "type": "disk",
      "key": "󰋊 DISK",
      "keyColor": "#06d6a0",
      "folders": ["/"],
      "format": "{size-used} / {size-total}",
    },

    "break",

    {
      "type": "custom",
      "format": "\t \u001b[38;5;220m󰮯 \t\t \u001b[38;5;208m󰊠 \u001b[38;5;46m󰊠 \u001b[38;5;39m󰊠 \u001b[38;5;99m󰊠 \u001b[38;5;82m󰊠 \u001b[38;5;45m󰊠",
    },
  ],
}
